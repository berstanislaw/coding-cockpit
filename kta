#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$DIR/bin/kta"
T=(tmux -L kta -f "$DIR/tmux.conf")

for c in tmux go claude; do
  command -v "$c" >/dev/null || { echo "$c missing (macOS: brew install $c · Arch: sudo pacman -S $c)"; exit 1; }
done

rebuilt=0
if [ ! -x "$BIN" ] || [ -n "$(find "$DIR" -maxdepth 1 -name '*.go' -newer "$BIN")" ]; then
  (cd "$DIR" && go build -o "$BIN" .)
  rebuilt=1
fi
if [ "${1:-}" = setup ]; then
  "$BIN" setup || exit 1
  rebuilt=1
fi
"$BIN" check || exit 1

if ! "${T[@]}" has-session -t kta 2>/dev/null; then
  exec "${T[@]}" new-session -s kta -n kta "$BIN"
fi
pane=$("${T[@]}" list-panes -s -t kta -F '#{pane_id} #{pane_current_command}' | awk '$2 == "kta" { print $1; exit }')
if [ -z "$pane" ]; then
  "${T[@]}" new-window -t kta -n kta "$BIN"
elif [ "$rebuilt" = 1 ]; then
  "${T[@]}" respawn-pane -k -t "$pane" "$BIN"
fi
"${T[@]}" source-file "$DIR/tmux.conf"
"${T[@]}" select-window -t kta:kta
exec "${T[@]}" attach -t kta
